   "source": [
    "## 4. CALIBRATION TO MARKET DATA\n",
    "\n",
    "### 4.1 Synthetic Market Data & Calibration\n",
    "\n",
    "In practice, we observe market prices and need to **fit** Heston parameters to match these prices.\n"   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Simulate \"market\" data with true underlying Heston model (with different params)\ntrue_pricer = HestonPricer(S0=100, r=0.05, kappa=1.5, theta=0.05,\n",
    "                          sigma_v=0.4, rho=-0.6, v0=0.05)\n\nmarket_strikes = np.linspace(85, 115, 15)\nmarket_prices = np.array([true_pricer.call_price_fft(K, 0.25) for K in market_strikes])\n\n# Add small noise (bid-ask spread, etc.)\nmarket_prices += np.random.normal(0, market_prices * 0.01)  # 1% noise\n\nprint(f\"\\nSimulated market data (15 options)\")\nprint(f\"True parameters: κ={true_pricer.kappa}, θ={true_pricer.theta}, σᵥ={true_pricer.sigma_v}, ρ={true_pricer.rho}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calibration: minimize RMSE\nclass HestonCalibrator:\n",
    "    def __init__(self, market_strikes, market_prices, T, S0, r):\n",
    "        self.market_strikes = market_strikes\n",
    "        self.market_prices = market_prices\n",
    "        self.T = T\n",
    "        self.S0 = S0\n",
    "        self.r = r\n",
    "    \n",
    "    def objective(self, params):\n",
    "        \"\"\"RMSE between model and market prices.\"\"\"\n",
    "        kappa, theta, sigma_v, rho, v0 = params\n",
    "        \n",
    "        # Constraints\n",
    "        if kappa <= 0 or theta <= 0 or sigma_v <= 0:\n",
    "            return 1e10\n",
    "        if abs(rho) >= 1:\n",
    "            return 1e10\n",
    "        if v0 <= 0:\n",
    "            return 1e10\n",
    "        \n",
    "        pricer = HestonPricer(S0=self.S0, r=self.r, kappa=kappa, theta=theta,\n",
    "                             sigma_v=sigma_v, rho=rho, v0=v0)\n",
    "        \n",
    "        model_prices = np.array([pricer.call_price_fft(K, self.T) for K in self.market_strikes])\n",
    "        \n",
    "        rmse = np.sqrt(np.mean((model_prices - self.market_prices) ** 2))\n",
    "        return rmse\n    \n",
    "    def calibrate(self):\n",
    "        \"\"\"Fit Heston parameters.\"\"\"\n",
    "        # Initial guess\n",
    "        x0 = [2.0, 0.04, 0.3, -0.7, 0.04]\n",
    "        \n",
    "        # Bounds\n",
    "        bounds = [(0.1, 10), (0.001, 0.5), (0.01, 1.0), (-0.99, 0.99), (0.001, 0.5)]\n",
    "        \n",
    "        # Use differential evolution for global optimization\n",
    "        result = differential_evolution(self.objective, bounds, seed=42, maxiter=100)\n",
    "        \n",
    "        return result.x, result.fun\n\ncalibrator = HestonCalibrator(market_strikes, market_prices, 0.25, 100, 0.05)\nparams_calibrated, rmse = calibrator.calibrate()\n\nkappa_cal, theta_cal, sigma_v_cal, rho_cal, v0_cal = params_calibrated\n\nprint(\"\\nCALIBRATION RESULTS\")\nprint(\"=\"*70)\nprint(f\"\\n{'Parameter':<20} {'True':>15} {'Calibrated':>15} {'Error':>15}\")\nprint(\"-\"*70)\nprint(f\"{'κ (mean reversion)':<20} {true_pricer.kappa:>15.4f} {kappa_cal:>15.4f} {abs(kappa_cal - true_pricer.kappa):>15.4f}\")\nprint(f\"{'θ (long-run var)':<20} {true_pricer.theta:>15.4f} {theta_cal:>15.4f} {abs(theta_cal - true_pricer.theta):>15.4f}\")\nprint(f\"{'σᵥ (vol of vol)':<20} {true_pricer.sigma_v:>15.4f} {sigma_v_cal:>15.4f} {abs(sigma_v_cal - true_pricer.sigma_v):>15.4f}\")\nprint(f\"{'ρ (correlation)':<20} {true_pricer.rho:>15.4f} {rho_cal:>15.4f} {abs(rho_cal - true_pricer.rho):>15.4f}\")\nprint(f\"{'v₀ (current var)':<20} {true_pricer.v0:>15.4f} {v0_cal:>15.4f} {abs(v0_cal - true_pricer.v0):>15.4f}\")\nprint(f\"\\nCalibration RMSE: ${rmse:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 4.2 Comparison: Market vs Calibrated Model"
   ]
